{
  "compilerOptions": {
    // Organização dos arquivos
    "rootDir": "./src",
    "outDir": "./dist",

    // Ambiente
    "module": "CommonJS",
    "target": "ES2020",
    "esModuleInterop": true,

    // Checagem de tipos
    "strict": true,

    // Outros
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Reconhece os tipos do Node.js
    "types": ["node"]
  },
  "include": ["src"]
}